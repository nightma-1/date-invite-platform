# Только ИМЕНА переменных. Реальные значения задаются в Vercel → Settings → Environment Variables.
# Ни одна из них не должна начинаться с VITE_ — такие переменные попадают в браузер.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

PUBLIC_APP_URL=

CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

TELEGRAM_BOT_TOKEN=
NOTIFY_WEBHOOK_SECRET=

# Техподдержка. Отдельный бот — не тот, что шлёт уведомления (@sentiuz_bot).
# SUPPORT_CHAT_ID — id рабочей группы, куда падают обращения; у групп он
# отрицательный, например -1001234567890. Бота нужно добавить в эту группу.
# Username бота поддержки задаётся в коде: src/lib/support.js
SUPPORT_BOT_TOKEN=
SUPPORT_CHAT_ID=

# Автоперевод образца на главной в админке (api/admin/translate.js).
# Ключ — console.anthropic.com → API Keys. Модель можно не задавать.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
